# Copy to .env for local development. Values below match docker-compose.yml defaults.
# In production every secret must be supplied explicitly; services refuse the dev defaults.

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (application metadata) ---
DATABASE_URL=postgres://traceforge:traceforge-dev@localhost:5433/traceforge

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- ClickHouse (telemetry storage) ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=traceforge
CLICKHOUSE_PASSWORD=traceforge-dev
CLICKHOUSE_DATABASE=traceforge

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# Origins allowed to make cookie-authenticated, state-changing requests (comma separated).
WEB_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=168
# Secure cookies are forced on when NODE_ENV=production.
INGEST_MAX_BODY_BYTES=4194304
INGEST_MAX_SPANS_PER_REQUEST=5000
INGEST_RATE_LIMIT_SPANS_PER_SECOND=2000
INGEST_RATE_LIMIT_BURST_SPANS=10000
# Allow user registration (disable on shared deployments after bootstrapping).
ALLOW_REGISTRATION=true

# --- Worker ---
WORKER_BATCH_MAX_MESSAGES=500
WORKER_BATCH_MAX_WAIT_MS=1000
WORKER_MAX_RETRIES=5
WORKER_RETRY_BASE_MS=250
WORKER_CONSUMER_CONCURRENCY=1
WORKER_METRICS_PORT=4001
ALERT_EVALUATION_INTERVAL_MS=15000

# --- Web ---
# Server-side URL the Next.js app uses to reach the API (also used by the /api rewrite).
API_INTERNAL_URL=http://localhost:4000

# --- Demo environment (never enable in production) ---
DEMO_MODE=true
DEMO_GATEWAY_PORT=4100
DEMO_INVENTORY_PORT=4101
DEMO_PAYMENTS_PORT=4102
# Where the demo services send OTLP; the API key is written by `pnpm demo:setup` into .env.demo
TRACEFORGE_OTLP_ENDPOINT=http://localhost:4000/v1/traces
