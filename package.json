{
  "name": "traceforge",
  "version": "0.1.0",
  "private": true,
  "description": "API observability and distributed tracing platform",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @traceforge/api --filter @traceforge/worker --filter @traceforge/web dev",
    "dev:demo": "pnpm --filter @traceforge/demo-service dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "pnpm --filter @traceforge/storage db:generate",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "demo:traffic": "tsx scripts/demo-traffic.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "smoke": "tsx scripts/smoke.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@traceforge/config": "workspace:*",
    "@traceforge/contracts": "workspace:*",
    "@traceforge/domain": "workspace:*",
    "@traceforge/messaging": "workspace:*",
    "@traceforge/storage": "workspace:*",
    "zod": "^4.6.7",
    "drizzle-orm": "^0.45.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "@traceforge/logger": "workspace:*",
    "postgres": "^3.4.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
